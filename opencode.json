{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "css": {
      "command": ["vscode-css-language-server", "--stdio"],
      "extensions": [".scss", ".css", ".sass"]
    }
  },
  "formatter": {
    "phpcbf": {
      "command": ["admin/vendor/bin/phpcbf", "$FILE"],
      "extensions": [".php"]
    },
    "stylelint-fix": {
      "command": ["npx", "stylelint", "--fix", "$FILE"],
      "extensions": [".scss"]
    }
  }
}