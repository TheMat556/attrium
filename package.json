{
  "name": "attrium",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && bun run build:css",
    "build:css": "sass scss/admin-theme.scss app/dist/admin-theme.tmp.css --no-source-map && tailwindcss -i app/dist/admin-theme.tmp.css -o app/dist/admin-theme.css --minify && rm -f app/dist/admin-theme.tmp.css",
    "watch:css": "sass --watch scss/admin-theme.scss:app/dist/admin-theme.tmp.css & tailwindcss -i app/dist/admin-theme.tmp.css -o app/dist/admin-theme.css --watch",
    "preview": "vite preview",
    "lint": "biome check --write src/",
    "lint:check": "biome check src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "wp-env": "wp-env",
    "test:visual": "wp-env start && bun run build && bash tests/visual/run-in-docker.sh; status=$?; wp-env stop; exit $status",
    "test:visual:update": "wp-env start && bun run build && bash tests/visual/run-in-docker.sh --update-snapshots; status=$?; wp-env stop; exit $status",
    "test:visual:local": "bash tests/visual/run-local.sh",
    "test:visual:report": "npx playwright show-report --host 0.0.0.0 --port 9323",
    "test:visual:report:components": "npx playwright show-report playwright-report-components --host 0.0.0.0 --port 9323"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@lucide/vue": "^1.21.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^3.0.2",
    "reka-ui": "^2.10.1",
    "shadcn-vue": "^2.7.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "@wordpress/env": "^11.11.0",
    "sass": "^1.86.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
